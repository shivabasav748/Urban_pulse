# Urban Pulse — Environment Variables
# Copy to .env.local for local development
# Never commit .env.local to git

# ─────────────────────────────────────
# Supabase (local — from `pnpm dlx supabase start`)
# ─────────────────────────────────────
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-local-anon-key-here

# ─────────────────────────────────────
# Supabase (hosted project — for deployment)
# ─────────────────────────────────────
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-hosted-anon-key-here

# ─────────────────────────────────────
# GitHub Pages base path (set during build for Pages deploy)
# ─────────────────────────────────────
# VITE_BASE_PATH=/Urban_pulse/

# ─────────────────────────────────────
# Supabase CLI (for db push to hosted project)
# Not needed for local development
# ─────────────────────────────────────
# SUPABASE_ACCESS_TOKEN=your-supabase-pat-here
# SUPABASE_PROJECT_ID=your-project-ref-here

# ─────────────────────────────────────
# Dev mode flag (shows demo accounts on login page)
# ─────────────────────────────────────
VITE_SHOW_DEMO_ACCOUNTS=true
